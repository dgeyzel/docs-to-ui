PLAIN_DEBUG=true
PLAIN_SECRET_KEY=dev_secret_key
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/docs_to_ui

# Gemini, used by the default LLM_MODEL (read by LiteLLM).
GEMINI_API_KEY=your-gemini-api-key

# Optional overrides (defaults shown)
# PLAIN_LLM_MODEL=gemini/gemini-3.8-flash
# PLAIN_LLM_THINKING_LEVEL=medium
# PLAIN_LLM_JUDGE_MODEL=gemini/gemini-3.8-flash
# PLAIN_LLM_JUDGE_THINKING_LEVEL=high
# PLAIN_LLM_PROGRAM_VERSION=baseline
# PLAIN_LLM_BATCH_TOKEN_BUDGET=60000
# PLAIN_LLM_BATCH_MAX_OPERATIONS=25
# PLAIN_LLM_MAX_CONCURRENCY=4
# PLAIN_LLM_FAKE_RESPONSES=tests/fixtures/llm/petstore.json
# PLAIN_GENERATIONS_MAX_INPUT_BYTES=5242880
# PLAIN_GENERATIONS_TIMEOUT_S=900
# PLAIN_SOURCES_ENABLED_ADAPTERS=["openapi","python"]
# PLAIN_SOURCES_ZIP_MAX_UNCOMPRESSED_BYTES=52428800
# PLAIN_SOURCES_ZIP_MAX_FILE_BYTES=5242880
# PLAIN_SOURCES_ZIP_MAX_ENTRIES=5000
# PLAIN_TELEMETRY_BACKENDS=["native"]
# PLAIN_TELEMETRY_SERVICE_NAME=docs-to-ui
# PLAIN_TELEMETRY_NATIVE_MAX_ATTRIBUTE_BYTES=262144
# PLAIN_TRACES_RETENTION_DAYS=30

# Required when "langfuse" is in PLAIN_TELEMETRY_BACKENDS
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# LANGFUSE_PUBLIC_KEY=pk-lf-placeholder
# LANGFUSE_SECRET_KEY=sk-lf-placeholder
# LANGFUSE_PROJECT_ID=your-project-id
