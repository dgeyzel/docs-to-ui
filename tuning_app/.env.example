PLAIN_DEBUG=true
PLAIN_SECRET_KEY=dev_secret_key
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/docs_to_ui

# Model provider keys for evals and optimization (read by LiteLLM).
GEMINI_API_KEY=your-gemini-api-key

# Optional overrides (defaults shown)
# PLAIN_TELEMETRY_BACKENDS=["native"]
# PLAIN_TELEMETRY_SERVICE_NAME=docs-to-ui

# Required when "langfuse" is in PLAIN_TELEMETRY_BACKENDS
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# LANGFUSE_PUBLIC_KEY=pk-lf-placeholder
# LANGFUSE_SECRET_KEY=sk-lf-placeholder
# LANGFUSE_PROJECT_ID=your-project-id
