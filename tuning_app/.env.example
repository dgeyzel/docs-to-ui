PLAIN_DEBUG=true
PLAIN_SECRET_KEY=dev_secret_key
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/docs_to_ui

# Provider keys, referenced by name from registered models (read by LiteLLM).
# The seeded models use these two; the seeded default judge is Claude.
GEMINI_API_KEY=your-gemini-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key

# Optional overrides (defaults shown)
# PLAIN_GOLDSETS_MAX_IMPORT_BYTES=10485760
# PLAIN_TELEMETRY_SERVICE_NAME=docs-to-ui
# PLAIN_TELEMETRY_NATIVE_MAX_ATTRIBUTE_BYTES=262144
# PLAIN_TELEMETRY_SETTINGS_TTL_S=10
# PLAIN_TELEMETRY_EXPORT_ENABLED=true

# Trace backends are chosen on the Settings page (/tuning/settings). Langfuse
# can be chosen once these are set here and in docs_app/.env.
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# LANGFUSE_PUBLIC_KEY=pk-lf-placeholder
# LANGFUSE_SECRET_KEY=sk-lf-placeholder
# LANGFUSE_PROJECT_ID=your-project-id
